# 此域名 A 记录应指向腾讯云服务器；Caddy 自动申请 HTTPS 证书。
BACKEND_DOMAIN=games-api.example.com
# 使用逗号分隔多个前端来源；若直接从后台域名游玩，也将它加入此列表。
GAMES_ALLOWED_ORIGINS=https://games.tangletang.top,https://games-api.example.com
# Studio：Gemini API Key（只放在这里或服务器环境变量里，不进仓库）。
GEMINI_API_KEY=
# Studio 共享口令：内测成员在 /studio/ 输入它才能创建项目和调用 AI。务必设置。
STUDIO_TOKEN=
# 可选：覆盖 backend/config/ai.json 里的模型和每日 token 上限。
# GEMINI_MODEL_AGENT=gemini-3.8-flash
# AI_DAILY_TOKENS=5000000
